module Lexer
complexity O(N)
{
    budget { power: 5000_nj }

    struct Token {
        type_id: i32,
        value: Stream
    }

    struct LexerState {
        source: Stream,
        cursor: i32
    }

    verify {
        test "token_proof" {
            let state = LexerState { source: "let", cursor: 0 };
            let token = next_token(state);
            assert(token.type_id != -1); 
            assert(tg_ir.no_implicit_iteration(next_token));
        }
    }
    func next_token(state: LexerState) -> Token {
        // Skip Whitespace
        while (state.cursor < 10000) {
            let c = state.source[state.cursor];
            if (c == 32 || c == 9 || c == 10 || c == 13) {
                state.cursor = state.cursor + 1;
            } else {
                break;
            }
        }
        
        if (state.cursor >= 10000) {
            return Token { type_id: 0, value: "EOF" };
        }
        
        let start = state.cursor;
        let c = state.source[state.cursor];
        
        if (c == 0) {
            return Token { type_id: 0, value: "EOF" };
        }

        // Identifier or Keyword
        if ((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95) {
            while (state.cursor < 10000) {
                let next_c = state.source[state.cursor];
                if ((next_c >= 65 && next_c <= 90) || (next_c >= 97 && next_c <= 122) || (next_c >= 48 && next_c <= 57) || next_c == 95) {
                    state.cursor = state.cursor + 1;
                } else {
                    break;
                }
            }
            return Token { type_id: 1, value: "ID" };
        }
        
        // Number
        if (c >= 48 && c <= 57) {
            while (state.cursor < 10000) {
                let next_c = state.source[state.cursor];
                if ((next_c >= 48 && next_c <= 57) || next_c == 46 || next_c == 95) {
                    state.cursor = state.cursor + 1;
                } else {
                    break;
                }
            }
            return Token { type_id: 2, value: "NUM" };
        }
        
        // Single char operators
        if (c == 61) { // '='
            state.cursor = state.cursor + 1;
            return Token { type_id: 3, value: "ASSIGN" };
        }

        if (c == 43) { // '+'
            state.cursor = state.cursor + 1;
            return Token { type_id: 4, value: "PLUS" };
        }

        if (c == 45) { // '-'
            state.cursor = state.cursor + 1;
            return Token { type_id: 5, value: "MINUS" };
        }

        state.cursor = state.cursor + 1;
        return Token { type_id: -1, value: "UNKNOWN" };
    }
}
