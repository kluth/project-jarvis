module Quantum
complexity O(2^N)
{
    budget { power: 10000_nj }

    verify {
        test "collapse_proof" {
            let input = tg_ir.mock_stream(1);
            let state = collapse_state(input);
            assert(state.value == input.value || state.value == (input.value * -1.0));
            assert(tg_ir.branch_probability_verified(collapse_state));
        }
        test "quantum_purity_proof" {
            assert(tg_ir.is_pure_jrv());
        }
    }
    func collapse_state(input: Stream) -> Stream {
        prob {
            0.5 => return input,
            0.5 => return input * -1.0,
        }
    }
}
