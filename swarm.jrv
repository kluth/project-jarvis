module Swarm
complexity O(N log N)
{
    budget { power: 5000_nj }

    verify {
        test "consensus_proof" {
            let nodes = tg_ir.mock_node_cluster(5);
            coordinate(nodes);
            assert(tg_ir.sync_protocol_active("raft"));
            assert(tg_ir.inspect_complexity(coordinate) == O(N log N));
        }
        test "swarm_purity_proof" {
            assert(tg_ir.no_external_linkage());
        }
    }
    func coordinate(nodes: Stream) -> Stream {
        knowledge SemanticIndex: 128
        
        sync "raft" {
            gossip "omni.bridge";
        }
        
        return nodes;
    }
}
