module DriverIO
complexity O(1)
{
    verify {
        test "real_classification_proof" {
            // RUTHLESS: Classify the real aplay binary from path
            let record = DiscoveryRecord { id: 1, transport: BusType.Shell_IPC, endpoint: "aplay", confidence: 1.0 };
            let class = classify(record, Capability { has_audio_out: true });
            assert(class == DeviceClass.AudioOut);
        }
        test "dispatch_is_lock_free" {
            assert(tg_ir.verify_lock_free(dispatch));
        }
        test "event_flow_integrity" {
            let ev = Event { type: EventType.Sync, code: 0, value: 0, timestamp: tg_ir.now(), device_id: 1 };
            dispatch(ev);
            assert(tg_ir.event_count() > 0);
        }
        test "atomic_ring_buffer_proof" {
            let rb = create_ring_buffer(64);
            assert(rb.size == 64);
            assert(tg_ir.is_lock_free_structure(rb.id));
        }
        test "dom_event_synthesis_proof" {
            let ev = Event { type: EventType.Pointer, code: 1, value: 0, timestamp: 0, device_id: 100 };
            DOM_event_synthetic(ev);
            assert(tg_ir.is_dom_event_injected(ev));
        }
        test "consumer_lifecycle_proof" {
            let handle = register_consumer(DeviceClass.Unknown, func(e: Event){});
            assert(handle.id != 0);
            unregister_consumer(handle);
        }
        test "emit_event_proof" {
            let r = DiscoveryRecord { id: 1 };
            emit_event(r, Event { type: EventType.Sync, code: 0, value: 0, timestamp: 0, device_id: 1 });
        }
        test "apply_quirk_proof" {
            let res = apply_quirk(1, func(e: Event) -> Event { return e; });
            assert(res.ok);
        }
        test "register_plugin_proof" {
            let h = register_plugin(func(e: Event) -> Event { return e; }, 1);
            assert(h.id != 0);
        }
        test "flush_frame_proof" {
            flush_frame(FrameBoundary { sync_event: Event { type: EventType.Sync, code: 0, value: 0, timestamp: 0, device_id: 1 } });
        }
        test "io_purity" {
            assert(tg_ir.is_native_substrate());
        }
    }

    type EventType { Key | Pointer | Touch | Axis | Absolute | Sync |
                      Audio | Network | Storage | Custom(code: U16) }
    type Event { type: EventType, code: U32, value: I64,
                 timestamp: U64, device_id: U64 }
    type DeviceClass { Keyboard | Pointer | Touchpad | Tablet | Joystick |
                       AudioIn | AudioOut | NetworkAdapter | Storage |
                       Sensor | RenderTarget | ComputeNode | Unknown | LLM_Swarm | WebBrowser | CodeRepository | Database | KnowledgeGraph | Tool_MCP | Tool_Compute | FileSystem }
    type QuirkTransform func(Event) -> Event
    type ConsumerHandle { id: U64 }
    type PluginHandle { id: U64 }
    type FrameBoundary { sync_event: Event }

    struct AtomicRingBuffer {
        id: i32,
        size: i32,
        read_idx: i32,
        write_idx: i32
    }

    func classify(device: DiscoveryRecord, caps: Capability) -> DeviceClass {
        budget { power: 50_nj }
        if caps.has_audio_out { return DeviceClass.AudioOut; }
        if device.endpoint == "git" { return DeviceClass.CodeRepository; }
        return DeviceClass.Unknown;
    }

    func register_consumer(class: DeviceClass, consumer: func(Event)) -> ConsumerHandle {
        budget { power: 100_nj }
        let id = tg_ir.register_event_consumer(class, consumer);
        return ConsumerHandle { id: id };
    }

    func unregister_consumer(handle: ConsumerHandle) -> Result {
        budget { power: 50_nj }
        return tg_ir.unregister_event_consumer(handle.id);
    }

    func dispatch(event: Event) {
        budget { power: 30_nj }
        tg_ir.event_dispatch(event);
    }

    func emit_event(device: DiscoveryRecord, event: Event) {
        budget { power: 30_nj }
        tg_ir.event_emit(device.id, event);
    }

    func apply_quirk(device_id: U64, xform: QuirkTransform) -> Result {
        budget { power: 100_nj }
        return tg_ir.register_device_quirk(device_id, xform);
    }

    func register_plugin(plugin: func(Event) -> Event, priority: U32) -> PluginHandle {
        budget { power: 100_nj }
        let id = tg_ir.register_event_plugin(plugin, priority);
        return PluginHandle { id: id };
    }

    func flush_frame(boundary: FrameBoundary) {
        budget { power: 50_nj }
        tg_ir.event_flush_frame(boundary.sync_event);
    }

    func create_ring_buffer(size: i32) -> AtomicRingBuffer {
        // ADR 002: Native lock-free ring buffer for stream communication.
        let id = tg_ir.allocate_lock_free_ring(size);
        return AtomicRingBuffer { id: id, size: size, read_idx: 0, write_idx: 0 };
    }

    func DOM_event_synthetic(event: Event) {
        // ADR 011: Injects web-originated DOM events into the substrate flow.
        tg_ir.hal_dom_inject_event(event);
    }
}
