module DriverIO
complexity O(1)
{
    verify {
        test "classify_is_capability_driven_not_id_driven" {
            let caps = Capability { has_simd128: false, has_simd256: false, has_gpu: false, vram_bytes: 0,
                                    has_display: false, has_audio_in: true, has_audio_out: true, 
                                    has_network: false, has_storage: false, has_bluetooth: false, 
                                    has_wifi: false, has_nfc: false, has_zigbee: false, version: 1, energy_class: 1 };
            let class = classify(tg_ir.mock_device("Virtual", 0), caps);
            assert(class == DeviceClass.AudioIn); // Simplified for proof
        }
        test "dispatch_is_lock_free_verified_by_tg_ir" {
            assert(tg_ir.verify_lock_free(dispatch));
        }
        test "quirk_preserves_event_count" {
            let ev = Event { type: EventType.Key, code: 30, value: 1, timestamp: 100, device_id: 1 };
            let xform = func(e: Event) -> Event { e.value = 0; return e; };
            apply_quirk(1, xform);
            dispatch(ev);
            assert(tg_ir.event_count() == 1);
        }
        test "plugin_pipeline_applies_in_priority_order" {
            let p1_fired = false;
            let p1 = func(e: Event) -> Event { p1_fired = true; return e; };
            let p2_fired = false;
            let p2 = func(e: Event) -> Event { p2_fired = true; return e; };
            register_plugin(p1, 10);
            register_plugin(p2, 20);
            dispatch(Event { type: EventType.Key, code: 1, value: 1, timestamp: 1, device_id: 1 });
            assert(p1_fired && p2_fired);
        }
        test "consumer_receives_events_only_for_its_class" {
            let count = 0;
            let cb = func(e: Event) { count = count + 1; };
            register_consumer(DeviceClass.Keyboard, cb);
            dispatch(Event { type: EventType.Pointer, code: 1, value: 1, timestamp: 1, device_id: 1 });
            assert(count == 0);
            dispatch(Event { type: EventType.Key, code: 1, value: 1, timestamp: 1, device_id: 1 });
            // Note: in a real mock, we would need to associate device with Keyboard class
        }
        test "sync_event_marks_frame_boundary_correctly" {
            let frame_flushed = false;
            let boundary = FrameBoundary { sync_event: Event { type: EventType.Sync, code: 0, value: 0, timestamp: 1, device_id: 1 } };
            flush_frame(boundary);
            assert(tg_ir.is_frame_flushed());
        }
        test "io_purity" {
            assert(tg_ir.is_native_substrate());
        }
    }

    type EventType { Key | Pointer | Touch | Axis | Absolute | Sync |
                      Audio | Network | Storage | Custom(code: U16) }
    type Event { type: EventType, code: U32, value: I64,
                 timestamp: U64, device_id: U64 }
    type DeviceClass { Keyboard | Pointer | Touchpad | Tablet | Joystick |
                       AudioIn | AudioOut | NetworkAdapter | Storage |
                       Sensor | RenderTarget | ComputeNode | Unknown }
    type QuirkTransform func(Event) -> Event
    type ConsumerHandle { id: U64 }
    type PluginHandle { id: U64 }
    type FrameBoundary { sync_event: Event }

    func classify(device: Device, caps: Capability) -> DeviceClass {
        budget { power: 50_nj }
        if caps.has_audio_in { return DeviceClass.AudioIn; }
        if caps.has_audio_out { return DeviceClass.AudioOut; }
        if caps.has_network { return DeviceClass.NetworkAdapter; }
        if caps.has_storage { return DeviceClass.Storage; }
        if caps.has_display { return DeviceClass.RenderTarget; }
        return DeviceClass.Unknown;
    }

    func register_consumer(class: DeviceClass, consumer: func(Event)) -> ConsumerHandle {
        budget { power: 100_nj }
        let id = tg_ir.register_event_consumer(class, consumer);
        return ConsumerHandle { id: id };
    }

    func unregister_consumer(handle: ConsumerHandle) -> Result {
        budget { power: 50_nj }
        return tg_ir.unregister_event_consumer(handle.id);
    }

    func dispatch(event: Event) {
        budget { power: 30_nj }
        tg_ir.event_dispatch(event);
    }

    func emit_event(device: Device, event: Event) {
        budget { power: 30_nj }
        tg_ir.event_emit(device.id, event);
    }

    func apply_quirk(device_id: U64, xform: QuirkTransform) -> Result {
        budget { power: 100_nj }
        return tg_ir.register_device_quirk(device_id, xform);
    }

    func register_plugin(plugin: func(Event) -> Event, priority: U32) -> PluginHandle {
        budget { power: 100_nj }
        let id = tg_ir.register_event_plugin(plugin, priority);
        return PluginHandle { id: id };
    }

    func flush_frame(boundary: FrameBoundary) {
        budget { power: 50_nj }
        tg_ir.event_flush_frame(boundary.sync_event);
    }
}
