module Kernel.Scheduler
complexity O(1)
{
    budget { power: 2500_nj }

    // Resolves ISSUE #20 — Kernel.Scheduler.on_frame.
    // Per-frame render hook driven by VSync. The callback receives a
    // monotonically-increasing frame counter that is the only animation
    // phase reference any layer should use. O(1) per dispatch, with frame
    // drops accounted for but never queued (no buffer buildup under load).

    struct FrameCallback {
        handler_ptr: Stream,
        frame_n: i32,
        cancelled: i32
    }

    struct DriverProfile {
        kind: i32,           // 0 = VBE poll, 1 = HPET, 2 = APIC timer
        rate_hz: i32,
        drift_ppm: i32
    }

    memory ACTIVE_CB: FrameCallback = FrameCallback { handler_ptr: "", frame_n: 0, cancelled: 0 }

    verify {
        test "dispatch_rate_proof" {
            // Under QEMU `-vga std` the callback MUST fire at >= 60 Hz with
            // no queue accumulation. The verifier samples the dispatch rate
            // over 256 frames.
            on_frame("UI.Aetheris.SpatialInterface.compose");
            assert(tg_ir.scheduler_dispatch_hz() >= 60);
            assert(tg_ir.scheduler_queue_depth() == 0);
        }
        test "monotonic_frame_counter_proof" {
            // frame_n MUST be strictly increasing across dispatches; never
            // reset, never repeated. Animation phase derives from it alone.
            on_frame("UI.Aetheris.SpatialInterface.compose");
            assert(tg_ir.frame_counter_strictly_increasing(256));
        }
        test "drop_under_load_proof" {
            // If the callback exceeds the per-frame budget, the next retrace
            // is logged as a drop — but the queue MUST stay empty so the
            // next dispatch resumes at the live retrace, not a backfilled one.
            tg_ir.stall_next_callback(50000);
            on_frame("UI.Aetheris.SpatialInterface.compose");
            assert(tg_ir.frame_drop_count() >= 1);
            assert(tg_ir.scheduler_queue_depth() == 0);
        }
        test "cancellable_proof" {
            // A registered callback can be cancelled. After cancellation,
            // no further dispatches occur until a new registration.
            on_frame("UI.Aetheris.SpatialInterface.compose");
            cancel();
            assert(tg_ir.callback_active() == 0);
        }
        test "o1_dispatch_proof" {
            // The dispatch path itself is O(1) — a single indirect call.
            // No scan, no list walk, no allocation.
            assert(tg_ir.inspect_complexity(dispatch_once) == O(1));
            assert(tg_ir.dispatch_call_count_per_tick() == 1);
        }
        test "boot_resume_phase_proof" {
            // After a sleep/resume cycle the frame counter MUST continue
            // from its prior value (or be re-seeded from boot_time_ms so
            // animations don't snap back to phase zero).
            assert(tg_ir.frame_counter_resume_safe());
        }
    }

    func on_frame(handler: Stream) {
        // Registers `handler` as the per-frame callback. The driver is
        // selected by capability detection: APIC > HPET > VBE poll. The
        // handler's resolved address MUST land in ACTIVE_CB.handler_ptr at
        // 0x9200 — without it the dispatch loop has nothing to invoke.
        let driver = select_driver();
        volatile write(0x9100, driver.kind);
        let handler_addr = tg_ir.callback_address(handler);
        volatile write(0x9200, handler_addr);
        volatile write(0x9208, 0);
    }

    func cancel() {
        // Marks the active callback as cancelled. handler_ptr (0x9200) is
        // cleared so the dispatcher never jumps to a stale address; the
        // cancelled flag lives at offset +8 (0x9208) per FrameCallback.
        volatile write(0x9200, 0);
        volatile write(0x9208, 1);
    }

    func dispatch_once(frame_n: i32) {
        // O(1) dispatch: a single indirect call through the callback slot.
        // The callback receives `frame_n` so all animation phase is derivable.
        Boot.Handoff.tick_frame();
        tg_ir.invoke_callback(frame_n);
    }

    func select_driver() -> DriverProfile {
        // Capability detection — APIC timer if present, then HPET, then VBE
        // vertical-retrace polling on port 0x3DA bit 3 as the universal
        // fallback (matches the prior asm renderer's behavior exactly).
        if tg_ir.apic_timer_present() == 1 {
            return DriverProfile { kind: 2, rate_hz: 60, drift_ppm: 50 };
        }
        if tg_ir.hpet_present() == 1 {
            return DriverProfile { kind: 1, rate_hz: 60, drift_ppm: 10 };
        }
        return DriverProfile { kind: 0, rate_hz: 60, drift_ppm: 500 };
    }
}
