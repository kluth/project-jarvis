module AssimilationPipeline
complexity O(N log N) // dominated by scanner across N devices
{
    verify {
        test "pipeline_real_execution" {
            // RUTHLESS: Execute the full JAP pipeline on the real git tool
            let records = AmbientScanner.scan_path();
            let ar = run_once(records.get(0));
            assert(ar.state == DriverState.Active);
            assert(tg_ir.verify_sequence(List[Str] { "Fingerprinter", "TrustPolicy", "Synthesizer", "Registry" }));
        }
        test "pipeline_run_proof" {
            let config = ScanConfig { mode: ScanMode.Passive };
            let s = run(config);
            assert(s.count >= 0);
        }
        test "pipeline_continuous_proof" {
            let handle = run_continuous(ScanConfig { mode: ScanMode.Passive }, func(ar: AssimilationRecord){});
            assert(handle.id != 0);
            stop(handle);
        }
        test "pipeline_total_energy_within_envelope" {
            let records = AmbientScanner.scan_path();
            let start = tg_ir.energy_consumed();
            run_once(records.get(0));
            assert(tg_ir.energy_consumed() - start <= 80000);
        }
        test "pipeline_purity" {
            assert(tg_ir.is_native_substrate());
        }
    }

    func run(config: ScanConfig) -> Stream[AssimilationRecord] {
        budget { power: 80000_nj }
        let discoveries = AmbientScanner.scan_all();
        let results = tg_ir.create_stream();
        for record in discoveries {
            results.append(run_once(record));
        }
        return results;
    }

    func run_once(record: DiscoveryRecord) -> AssimilationRecord {
        // RUTHLESS: Real multi-stage assimilation
        let existing = AmbientDeviceRegistry.lookup_by_address(record.endpoint);
        if existing.is_some {
            let handle = AmbientDeviceRegistry.fast_reactivate(existing.device_id);
            return tg_ir.to_assimilation_record(existing, handle);
        }

        let fp = DeviceFingerprinter.fingerprint(record);
        let trust = TrustPolicy.evaluate(fp.profile, fp.confidence);
        let ar = DriverSynthesizer.assimilate(record, fp.profile, trust);
        
        let entry = RegistryEntry { 
            device_id: ar.device_id, 
            record: record, 
            profile: fp.profile, 
            trust: trust, 
            state: DriverState.Active, 
            driver_handle: Option.Some(DriverHandle { module_id: ar.driver_id }),
            tombstone: false,
            assimilated_at_ms: ar.assimilated_at_ms,
            last_seen_ms: ar.last_seen_ms,
            miss_count: 0
        };
        AmbientDeviceRegistry.register(entry);
        
        if fp.profile.class == DeviceClass.LLM_Swarm {
            Brain.notify_swarm_node(ar);
        } else {
            tg_ir.call("Brain.notify", ar);
        }
        return ar;
    }

    func run_continuous(config: ScanConfig, cb: func(AssimilationRecord)) -> PipelineHandle {
        budget { power: 1000_nj }
        let id = tg_ir.start_assimilation_loop(config, cb);
        return PipelineHandle { id: id };
    }

    func stop(handle: PipelineHandle) -> Result {
        budget { power: 100_nj }
        return tg_ir.stop_assimilation_loop(handle.id);
    }
}
