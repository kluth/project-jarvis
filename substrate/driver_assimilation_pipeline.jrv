module AssimilationPipeline
complexity O(N log N) // dominated by scanner across N devices
{
    verify {
        test "pipeline_stages_execute_in_declared_order" {
            let record = tg_ir.mock_discovery_record();
            run_once(record);
            assert(tg_ir.verify_sequence(List[Str] { "Scanner", "Registry", "Fingerprinter", "TrustPolicy", "Synthesizer", "Brain" }));
        }
        test "fast_path_skips_stages_3_through_6_for_known_device" {
            let record = tg_ir.mock_discovery_record();
            tg_ir.mock_registry_hit(record.address);
            run_once(record);
            assert(tg_ir.call_count("DeviceFingerprinter.fingerprint") == 0);
            assert(tg_ir.call_count("DriverSynthesizer.synthesize") == 0);
        }
        test "failed_synthesis_falls_through_to_passthrough_not_abort" {
            tg_ir.fail_synthesis_permanently();
            let record = tg_ir.mock_discovery_record();
            let ar = run_once(record);
            assert(ar.driver_id != 0);
            assert(tg_ir.is_passthrough_driver(ar.driver_id));
        }
        test "brain_notified_after_every_successful_assimilation" {
            let record = tg_ir.mock_discovery_record();
            run_once(record);
            assert(tg_ir.call_count("Brain.notify") == 1);
        }
        test "pipeline_total_energy_within_combined_envelope" {
            let record = tg_ir.mock_discovery_record();
            let start = tg_ir.energy_consumed();
            run_once(record);
            assert(tg_ir.energy_consumed() - start <= 80000);
        }
        test "pipeline_purity" {
            assert(tg_ir.is_native_substrate());
        }
    }

    func run(config: ScanConfig) -> Stream[AssimilationRecord] {
        budget { power: 80000_nj }
        let discoveries = AmbientScanner.scan(config);
        let results = tg_ir.create_stream();
        for record in discoveries {
            results.append(run_once(record));
        }
        return results;
    }

    func run_once(record: DiscoveryRecord) -> AssimilationRecord {
        // Stage 2: Registry Lookup (Fast Path)
        let existing = AmbientDeviceRegistry.lookup_by_address(record.address);
        if existing.is_some {
            let handle = AmbientDeviceRegistry.fast_reactivate(existing.device_id);
            return tg_ir.to_assimilation_record(existing, handle);
        }

        // Stage 3: Fingerprinting
        let fp = DeviceFingerprinter.fingerprint(record);
        
        // Stage 4: Trust Evaluation
        let trust = TrustPolicy.evaluate(fp.profile, fp.confidence);
        
        // Stage 5 & 6: Synthesis & Injection
        let ar = DriverSynthesizer.assimilate(record, fp.profile, trust);
        
        // Stage 7 & 8: Registration & Heartbeat
        let entry = RegistryEntry { 
            device_id: ar.device_id, 
            record: record, 
            profile: fp.profile, 
            trust: trust, 
            state: DriverState.Active, 
            driver_handle: Option.Some(DriverHandle { module_id: ar.driver_id }),
            tombstone: false,
            assimilated_at_ms: ar.assimilated_at_ms,
            last_seen_ms: ar.last_seen_ms,
            miss_count: 0
        };
        AmbientDeviceRegistry.register(entry);
        AmbientDeviceRegistry.start_heartbeat_loop(ar.device_id, HeartbeatConfig { interval_ms: 5000, max_misses: 5 });
        
        // Stage 9: Brain Notification
        tg_ir.call("Brain.notify", ar);
        
        return ar;
    }

    func run_continuous(config: ScanConfig, cb: func(AssimilationRecord)) -> PipelineHandle {
        budget { power: 1000_nj }
        let id = tg_ir.start_assimilation_loop(config, cb);
        return PipelineHandle { id: id };
    }

    func stop(handle: PipelineHandle) -> Result {
        budget { power: 100_nj }
        return tg_ir.stop_assimilation_loop(handle.id);
    }

    func get_stage_stats() -> PipelineStats {
        return tg_ir.get_pipeline_metrics();
    }
}
