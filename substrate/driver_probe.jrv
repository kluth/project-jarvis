module DriverProbe
complexity O(1)
{
    verify {
        test "probe_is_deterministic" {
            // RUTHLESS: Use the real Bridge device found in sysfs
            let records = AmbientScanner.scan_sysfs_pci();
            let device = records.get(0);
            let res1 = probe(device);
            let res2 = probe(device);
            assert(res1 == res2);
        }
        test "negotiate_tiered_logic" {
            let caps = Capability { has_simd256: true, version: 2, energy_class: 1 };
            let path = negotiate(caps);
            assert(path == CodePath.Optimal);
        }
        test "fallback_resolution_proof" {
            let path = resolve_fallback("NO_GPU");
            assert(path == CodePath.Minimal);
        }
        test "deferred_probe_lifecycle" {
            let fired = false;
            let cb = func() { fired = true; };
            let handle = defer_until(func() -> Bool { return true; }, cb);
            tg_ir.trigger_defer(handle);
            assert(fired == true);
        }
        test "probe_purity" {
            assert(tg_ir.is_native_substrate());
        }
    }

    type ProbeResult { Ok(Capability) | Deferred(reason: Str) | Failed(err: Str) }
    type Capability { has_simd128: Bool, has_simd256: Bool, has_gpu: Bool,
                      vram_bytes: U64, version: U32, energy_class: U8 }
    type CodePath { Optimal | Tiered(level: i32) | Fallback(reason: Str) | Minimal }
    type DeferHandle { id: U64 }

    func probe(device: DiscoveryRecord) -> ProbeResult {
        budget { power: 500_nj }
        let caps = tg_ir.inspect_device_caps(device);
        return ProbeResult.Ok(caps);
    }

    func negotiate(caps: Capability) -> CodePath {
        budget { power: 100_nj }
        // ADR 010: Tiered negotiation based on version and energy class.
        if caps.has_simd256 && caps.version >= 2 { return CodePath.Optimal; }
        if caps.has_simd128 { return CodePath.Tiered(1); }
        return CodePath.Minimal;
    }

    func resolve_fallback(reason: Str) -> CodePath {
        // Dynamically adapts execution based on the failure reason.
        if tg_ir.string_contains(reason, "NO_GPU") { return CodePath.Minimal; }
        return CodePath.Fallback(reason);
    }

    func defer_until(cond: func() -> Bool, cb: func) -> DeferHandle {
        budget { power: 150_nj }
        let id = tg_ir.register_deferred_action(cond, cb);
        return DeferHandle { id: id };
    }
}